<Window x:Class="Wpe.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Phantom Render" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/phantom.ico">
    <StackPanel Margin="32,28,32,28">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Image Source="pack://application:,,,/Assets/icon.png" Width="64" Height="64" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Welcome to Phantom Render" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Hint}" Text="Live video wallpapers that step aside when you play. Three quick choices and you're done." />
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="1. Your wallpaper videos" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,8" Text="A folder with .mp4, .mkv, .webm, .mov or .gif files. You can add more folders later." />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse..." Click="Browse_Click" Margin="8,0,0,0" />
                    <TextBox x:Name="FolderBox" TextChanged="FolderBox_TextChanged" />
                </DockPanel>
                <TextBlock x:Name="FolderInfo" Style="{StaticResource Hint}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="2. While you play" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,8" Text="What happens to the wallpaper when a fullscreen or borderless game is in front." />
                <RadioButton x:Name="StopRadio" GroupName="mode" IsChecked="True" Foreground="{StaticResource Text}" Margin="0,2">
                    <TextBlock><Run Text="Stop the video (recommended)" FontWeight="SemiBold" /><Run Text="  uses no GPU or VRAM at all, shows a still frame" Foreground="{StaticResource Muted}" /></TextBlock>
                </RadioButton>
                <RadioButton x:Name="FreezeRadio" GroupName="mode" Foreground="{StaticResource Text}" Margin="0,2">
                    <TextBlock><Run Text="Freeze the video" FontWeight="SemiBold" /><Run Text="  resumes instantly, keeps the player in memory" Foreground="{StaticResource Muted}" /></TextBlock>
                </RadioButton>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="3. Startup" FontWeight="SemiBold" Margin="0,0,0,6" />
                <CheckBox x:Name="StartupCheck" Style="{StaticResource Switch}" IsChecked="True" Content="Start with Windows" />
            </StackPanel>
        </Border>

        <Border x:Name="MpvCard" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Video player" FontWeight="SemiBold" />
                <TextBlock x:Name="MpvInfo" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                <ProgressBar x:Name="MpvProgress" Height="4" Margin="0,8,0,0" Maximum="1" Visibility="Collapsed"
                             Foreground="{StaticResource Accent}" Background="{StaticResource Raised}" BorderThickness="0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button x:Name="StartButton" Content="Start Phantom Render" Style="{StaticResource Primary}" Click="Start_Click" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
