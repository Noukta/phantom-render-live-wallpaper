<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PhantomRender</AssemblyName>
    <RootNamespace>Wpe.UI</RootNamespace>
    <Version>0.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Lower startup cost: ReadyToRun precompiles, tiered PGO off keeps memory steady. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>false</TieredPGO>
    <!-- No InvariantGlobalization: WPF needs real cultures for text layout. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wpe.Core\Wpe.Core.csproj" />
  </ItemGroup>
</Project>
